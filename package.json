{
  "name": "career-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:source": "node scripts/verify-source.mjs",
    "smoke:judge": "tsx scripts/judge-smoke.ts",
    "smoke:acceptance": "tsx scripts/acceptance-journey.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^11.10.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
