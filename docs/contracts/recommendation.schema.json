{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career Quest model-neutral recommendation response draft",
  "description": "Проектный контракт на основе S-FINAL 11.3. Не доказывает поддержку конкретным API. Применяется к непустому пулу; eligibility, уникальность event_id и истинность evidence проверяет сервер.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendations",
    "warnings"
  ],
  "properties": {
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "reason",
          "factor_keys",
          "evidence_ids",
          "alternative_event_id",
          "alternative_reason"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "factor_keys": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "grade",
                "skill_gap",
                "history",
                "target_requirements"
              ]
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "alternative_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "alternative_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
