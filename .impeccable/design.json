{
  "schemaVersion": 1,
  "name": "Career Quest working atlas",
  "mode": "operate",
  "colors": {
    "ink": "#20252D",
    "muted": "#59616D",
    "page": "#F6F5F1",
    "surface": "#FFFFFF",
    "sidebar": "#FFFFFF",
    "secondarySurface": "#EFEEE8",
    "border": "#DADCE0",
    "primary": "#2846C7",
    "primarySurface": "#E8ECFC",
    "success": "#176742",
    "successSurface": "#E7F4EC",
    "warning": "#865B13",
    "warningSurface": "#FFF1D8",
    "error": "#A83439",
    "errorSurface": "#FCE9E8"
  },
  "typography": {
    "family": "Noto Sans, Arial, sans-serif",
    "bodySize": 16,
    "tableSize": 14,
    "captionFloor": 12,
    "numerals": "tabular-nums"
  },
  "radii": { "control": 8, "panel": 12 },
